<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>OkControls</RootNamespace>
    <AssemblyName>OkControls</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Description>Windows Forms controls: HoldButton (hold to confirm, fills while held, fires on release) and TileButton.</Description>
    <Authors>OnlineKraft UG</Authors>
    <Copyright>© 2026 OnlineKraft UG</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/ptrmohr/okHoldButton</RepositoryUrl>
    <Version>1.0.0</Version>
  </PropertyGroup>

</Project>
